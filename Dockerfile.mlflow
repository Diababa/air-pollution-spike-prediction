FROM python:3.11-slim

RUN pip install --no-cache-dir mlflow==3.16.1

EXPOSE 5000

# Base SQLite (exigée par le Model Registry) et artefacts dans un volume.
# --artifacts-destination : les clients envoient les modèles via le serveur,
# ils n'ont pas besoin d'accéder directement au disque.
# --allowed-hosts : MLflow refuse par défaut les en-têtes Host inconnus,
# il faut autoriser le nom de service utilisé par le conteneur Airflow.
CMD ["mlflow", "server", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--allowed-hosts", "mlflow:5000,localhost:5000,127.0.0.1:5000"]
