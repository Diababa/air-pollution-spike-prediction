+# Stack MLOps locale : serveur MLflow + Airflow (mode standalone).
+#   docker compose -f docker-compose.mlops.yml up --build
+#   MLflow  : http://localhost:5000
+#   Airflow : http://localhost:8080  (mot de passe admin dans les logs)
+services:
+  mlflow:
+    build:
+      context: .
+      dockerfile: Dockerfile.mlflow
+    container_name: air_pollution_mlflow
+    ports:
+      - "5000:5000"
+    volumes:
+      - mlflow-data:/mlflow
+
+  airflow:
+    build:
+      context: .
+      dockerfile: Dockerfile.airflow
+    container_name: air_pollution_airflow
+    command: standalone
+    user: "${AIRFLOW_UID:-50000}:0"
+    ports:
+      - "8080:8080"
+    environment:
+      AIRFLOW__CORE__LOAD_EXAMPLES: "false"
+      AIRFLOW__CORE__DAGS_FOLDER: /opt/airflow/project/dags
+      AIR_POLLUTION_PROJECT_DIR: /opt/airflow/project
+      PYTHONPATH: /opt/airflow/project
+      MLFLOW_TRACKING_URI: http://mlflow:5000
+    volumes:
+      - ./:/opt/airflow/project
+    depends_on:
+      - mlflow
+
+volumes:
+  mlflow-data:
