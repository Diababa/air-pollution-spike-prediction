# Copier ce fichier en .env puis adapter les valeurs.
# Aucun secret n'est nécessaire pour faire tourner le projet :
# les données proviennent des API publiques Open-Meteo (sans clé).

# URL de l'endpoint de prédiction appelé par le dashboard Streamlit.
# Local (hors Docker)   : http://localhost:8000/predict-spike
# Docker Compose        : http://api:8000/predict-spike
# Render (production)   : https://air-pollution-api.onrender.com/predict-spike
API_URL=http://localhost:8000/predict-spike
